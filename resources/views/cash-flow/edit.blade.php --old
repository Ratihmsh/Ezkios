<script>
    // Dynamic select based on type selection
    const incomeCategories = @json($incomeCategories->pluck('name'));
    const expenseCategories = @json($expenseCategories->pluck('name'));

    const categorySelect = document.getElementById('category');
    const categoryNew = document.getElementById('category_new');
    const oldCategory = document.getElementById('old_category').value;

    document.getElementById('type').addEventListener('change', function() {
        const type = this.value;

        // Clear existing options
        categorySelect.innerHTML = '<option value="">Pilih Kategori</option>';

        let activeCategories = [];
        if (type === 'income') {
            activeCategories = incomeCategories;
        } else if (type === 'expense') {
            activeCategories = expenseCategories;
        }

        let foundOld = false;
        // Populate select
        activeCategories.forEach(function(cat) {
            const option = document.createElement('option');
            option.value = cat;
            option.textContent = cat;
            if (cat === oldCategory) {
                option.selected = true;
                foundOld = true;
            }
            categorySelect.appendChild(option);
        });

        // Add 'Lainnya' option
        const otherOption = document.createElement('option');
        otherOption.value = 'Lainnya_Baru';
        otherOption.textContent = '+ Tambah Kategori Baru...';
        categorySelect.appendChild(otherOption);

        // If old category is not found in the list but exists, select Lainnya and show input
        if (oldCategory && !foundOld) {
            otherOption.selected = true;
            categoryNew.value = oldCategory;
        }

        categorySelect.dispatchEvent(new Event('change'));
    });

    categorySelect.addEventListener('change', function() {
        if (this.value === 'Lainnya_Baru') {
            categoryNew.classList.remove('d-none');
            categoryNew.required = true;
            categoryNew.name = 'category';
            categorySelect.name = 'category_select';
        } else {
            categoryNew.classList.add('d-none');
            categoryNew.required = false;
            categoryNew.name = 'category_new';
            categorySelect.name = 'category';
        }
    });

    // Formatting nominal amount (Ribuan)
    const amountInput = document.getElementById('amount');
    amountInput.addEventListener('input', function(e) {
        let value = this.value.replace(/[^,\d]/g, '').toString();
        let split = value.split(',');
        let sisa = split[0].length % 3;
        let rupiah = split[0].substr(0, sisa);
        let ribuan = split[0].substr(sisa).match(/\d{3}/gi);

        if (ribuan) {
            let separator = sisa ? '.' : '';
            rupiah += separator + ribuan.join('.');
        }

        rupiah = split[1] !== undefined ? rupiah + ',' + split[1] : rupiah;
        this.value = rupiah;
    });

    // Payment Methods Logic
    const paymentMethods = @json($paymentMethods->pluck('name'));
    const paymentSelect = document.getElementById('payment_method');
    const paymentNew = document.getElementById('payment_method_new');
    const oldPaymentMethod = document.getElementById('old_payment_method').value;

    function initPaymentMethods() {
        paymentSelect.innerHTML = '<option value="">Pilih Metode</option>';
        let foundOldPayment = false;

        paymentMethods.forEach(function(pm) {
            const option = document.createElement('option');
            option.value = pm;
            option.textContent = pm;
            if (pm === oldPaymentMethod) {
                option.selected = true;
                foundOldPayment = true;
            }
            paymentSelect.appendChild(option);
        });

        const otherOptionPayment = document.createElement('option');
        otherOptionPayment.value = 'Lainnya_Baru';
        otherOptionPayment.textContent = '+ Tambah Metode Baru...';
        paymentSelect.appendChild(otherOptionPayment);

        if (oldPaymentMethod && !foundOldPayment) {
            otherOptionPayment.selected = true;
            paymentNew.value = oldPaymentMethod;
        }

        paymentSelect.dispatchEvent(new Event('change'));
    }

    paymentSelect.addEventListener('change', function() {
        if (this.value === 'Lainnya_Baru') {
            paymentNew.classList.remove('d-none');
            paymentNew.required = true;
            paymentNew.name = 'payment_method';
            paymentSelect.name = 'payment_method_select';
        } else {
            paymentNew.classList.add('d-none');
            paymentNew.required = false;
            paymentNew.name = 'payment_method_new';
            paymentSelect.name = 'payment_method';
        }
    });

    document.addEventListener('DOMContentLoaded', function() {
        document.getElementById('type').dispatchEvent(new Event('change'));
        initPaymentMethods();
    });
</script>
